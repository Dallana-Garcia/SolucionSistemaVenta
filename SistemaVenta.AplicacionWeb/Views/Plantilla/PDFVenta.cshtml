@model SistemaVenta.AplicacionWeb.Models.ViewModels.VMPDFVenta;
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>ImprimirVenta</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f9f9f9;
            color: #333;
            margin: 0;
            padding: 20px;
        }

        .contenedor {
            max-width: 900px;
            margin: auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h1, h2 {
            color: #FFB6C1; /* Rosa pastel */
            text-align: center;
            margin: 0 0 20px;
        }

        .subtitulo {
            text-align: right;
            font-weight: bold;
            color: #FFB6C1; /* Rosa pastel */
        }

        p {
            margin: 5px 0;
        }

        .informacion {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .informacion div {
            width: 48%;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        th {
            background-color: #FFB6C1; /* Rosa pastel */
            color: white;
            padding: 12px;
            text-align: left;
        }

        td {
            padding: 10px;
            border-bottom: 1px solid #eee;
        }

        .total {
            font-weight: bold;
            background-color: #f2f2f2;
        }

        .item-total {
            background-color: #FFB6C1; /* Rosa pastel */
            color: white;
            font-weight: bold;
        }

        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 12px;
            color: #888;
        }
    </style>
</head>
<body>
    <div class="contenedor">
        <img src="@Model.negocio.UrlLogo" style="width: 120px; height: 120px; display: block; margin: 0 auto;"/>

        <h1>@Model.negocio.Nombre.ToUpper()</h1>
        <p class="subtitulo">NÚMERO VENTA: @Model.venta.NumeroVenta</p>

        <div class="informacion">
            <div>
                <p><strong>Dirección:</strong> @Model.negocio.Direccion</p>
                <p><strong>Correo:</strong> @Model.negocio.Correo</p>
            </div>
            <div>
                <p><strong>CLIENTE:</strong></p>
                <p>@Model.venta.NombreCliente</p>
                <p>@Model.venta.DocumentoCliente</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.venta.DetalleVenta)
                {
                        <tr>
                            <td>@item.DescripcionProducto</td>
                            <td>@item.Cantidad</td>
                            <td>@Model.negocio.SimboloMoneda @item.Precio</td>
                            <td>@Model.negocio.SimboloMoneda @item.Total</td>
                        </tr>
                }
                <tr class="total">
                    <td colspan="2">Sub Total</td>
                    <td colspan="2" class="item-total">@Model.negocio.SimboloMoneda @Model.venta.SubTotal</td>
                </tr>
                <tr class="total">
                    <td colspan="2">IGV</td>
                    <td colspan="2" class="item-total">@Model.negocio.SimboloMoneda @Model.venta.ImpuestoTotal</td>
                </tr>
                <tr class="total">
                    <td colspan="2">Total</td>
                    <td colspan="2" class="item-total">@Model.negocio.SimboloMoneda @Model.venta.Total</td>
                </tr>
            </tbody>
        </table>

        <div class="footer">
            <p>Gracias por su compra!</p>
            <p>Visítenos en nuestro sitio web: @Model.negocio.UrlLogo</p>
        </div>
    </div>
</body>
</html>
